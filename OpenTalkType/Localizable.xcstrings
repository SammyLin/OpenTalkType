    "Ends the current dictation session, cleans the text up and pastes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet das laufende Diktat, bereinigt den Text und fügt ihn ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el dictado en curso, limpia el texto y lo pega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine la dictée en cours, nettoie le texte et le colle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のディクテーションを終了し、テキストを整理して貼り付けます。"
          }
        },
        "ko": {

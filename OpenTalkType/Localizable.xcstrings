    "claude did not respond within %d seconds and was stopped. The original transcript is on the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "claude hat nicht innerhalb von %d Sekunden geantwortet und wurde gestoppt. Das ursprüngliche Transkript liegt in der Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "claude no ha respondido en %d segundos y se ha detenido. La transcripción original está en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude n’a pas répondu en %d secondes et a été interrompu. La transcription d’origine est dans le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude が %d 秒以内に応答しなかったため中止しました。元の文字起こしはクリップボードにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude가 %d초 안에 응답하지 않아 중단했습니다. 원본 텍스트는 클립보드에 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

    "Double-tap fn to lock, so you do not have to hold it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fn zweimal antippen zum Feststellen, statt sie zu halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar fn dos veces para bloquear y no tener que mantenerla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyer deux fois sur fn pour verrouiller, sans maintenir la touche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fn を 2 回押してロックし、押しっぱなしにしない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fn을 두 번 눌러 잠가서 계속 누르고 있지 않기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下 fn 鎖定，不用一直按著"
          }
        }
      }
    },
    "Double-tap to lock the microphone on so you can let go. Press fn once more when you have finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal antippen hält das Mikrofon offen, du kannst loslassen. Am Ende noch einmal fn drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Púlsala dos veces para dejar el micrófono abierto y poder soltar. Vuelve a pulsar fn cuando termines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois pour verrouiller le microphone et lâcher la touche. Réappuyez sur fn quand vous avez fini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 回押すとマイクがロックされ、手を放せます。話し終わったらもう一度 fn を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 누르면 마이크가 잠겨 손을 떼도 됩니다. 다 말한 뒤 fn을 한 번 더 누르세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下鎖住麥克風，手可以放開；說完再按一下 fn 結束。"
          }
        }
      }
    },
    "Downloading language model": {
      "localizations": {

    "Open Microphone Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon-Einstellungen öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

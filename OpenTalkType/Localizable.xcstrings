    "Cleans up what you said and inserts it at the cursor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigt das Gesagte und fügt es an der Einfügemarke ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule lo que has dicho y lo inserta en el cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met au propre ce que vous avez dit et l’insère au curseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を整った文章に整理して、カーソル位置に挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용을 다듬어 커서 위치에 넣습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把口語整理成通順的文字，插入游標位置。"
          }
        }
      }
    },
    "Cleanup failed, the original text is on the clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung fehlgeschlagen, der Originaltext liegt in der Zwischenablage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza ha fallado; el texto original está en el portapapeles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage a échoué, le texte d’origine est dans le presse-papiers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理に失敗しました。元のテキストはクリップボードにあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리에 실패했습니다. 원본 텍스트는 클립보드에 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理失敗，原文已複製到剪貼簿"
          }
        }
      }
    },
    "Cleanup failed, the raw transcript is on the clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung fehlgeschlagen, das Rohtranskript liegt in der Zwischenablage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza ha fallado; la transcripción original está en el portapapeles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

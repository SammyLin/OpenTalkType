    "An app is using secure input": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App verwendet die geschützte Eingabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app está usando la entrada segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app utilise la saisie sécurisée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ保護された入力を使用中の App があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 입력을 사용 중인 앱이 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 App 正在使用安全輸入"
          }
        }
      }
    },
    "An app is using secure input, either a password field or Secure Keyboard Entry in Terminal. The text is on the clipboard, so press ⌘V.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App verwendet die geschützte Eingabe – ein Passwortfeld oder die geschützte Tastatureingabe im Terminal. Der Text liegt in der Zwischenablage, drück ⌘V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app está usando la entrada segura, ya sea un campo de contraseña o la Entrada Segura de Teclado de Terminal. El texto está en el portapapeles: pulsa ⌘V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app utilise la saisie sécurisée : un champ de mot de passe ou la « Saisie sécurisée » du Terminal. Le texte est dans le presse-papiers, appuyez sur ⌘V."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード入力欄か、ターミナルの「セキュリティ保護されたキーボード入力」により、セキュリティ保護された入力が有効になっています。テキストはクリップボードにあるので ⌘V を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 입력란이나 터미널의 ‘보안 키보드 입력’ 때문에 보안 입력이 켜져 있습니다. 텍스트는 클립보드에 있으니 ⌘V를 누르세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 App 正在使用安全輸入（密碼欄位，或終端機的「安全鍵盤輸入」）。文字已放在剪貼簿，請按 ⌘V。"
          }
        }
      }
    },
    "Another dictation is running. Let go of fn and try again.": {
      "localizations": {

          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages du Microphone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 설정 열기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟麥克風設定"
          }
        }
      }
    },
    "Open-source software released under the MIT license. Speech recognition runs on device; only the transcript to be cleaned up is sent to the AI provider you configured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-Source-Software unter der MIT-Lizenz. Die Spracherkennung läuft auf dem Gerät; nur das zu bereinigende Transkript geht an den von dir eingerichteten KI-Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Software de código abierto publicado bajo la licencia MIT. El reconocimiento de voz se ejecuta en el dispositivo; solo se envía al proveedor de IA que hayas configurado la transcripción que hay que limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logiciel libre publié sous licence MIT. La reconnaissance vocale s’exécute sur l’appareil ; seule la transcription à nettoyer est envoyée au fournisseur d’IA que vous avez configuré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT ライセンスで公開されているオープンソースソフトウェアです。音声認識はデバイス上で行われ、外部に送られるのは整理する文字起こしだけで、送り先はあなたが設定した AI プロバイダです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT 라이선스로 공개된 오픈 소스 소프트웨어입니다. 음성 인식은 기기에서 이루어지며, 정리할 텍스트만 직접 설정한 AI 제공자에게 전송됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 MIT 授權釋出的開放原始碼軟體。語音辨識在裝置上完成，只有要整理的逐字稿會送到你自己設定的 AI 供應商。"
          }
        }
      }
    },
    "OpenTalkType": {
      "shouldTranslate": false
    },
    "OpenTalkType has no microphone access. Open System Settings → Privacy & Security → Microphone and turn on OpenTalkType.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType hat keinen Mikrofonzugriff. Öffne Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon und aktivier OpenTalkType."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType no tiene acceso al micrófono. Abre Ajustes del Sistema → Privacidad y seguridad → Micrófono y activa OpenTalkType."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType n’a pas accès au microphone. Ouvrez Réglages Système → Confidentialité et sécurité → Microphone et activez OpenTalkType."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType にマイクへのアクセス権がありません。「システム設定 → プライバシーとセキュリティ → マイク」で OpenTalkType をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType에 마이크 접근 권한이 없습니다. ‘시스템 설정 → 개인정보 보호 및 보안 → 마이크’에서 OpenTalkType을 켜세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有麥克風權限。請到「系統設定 → 隱私權與安全性 → 麥克風」勾選 OpenTalkType。"
          }
        }
      }
    },
    "OpenTalkType needs your microphone to hear you. Recognition runs entirely on this Mac, so your voice never leaves the machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType braucht dein Mikrofon, um dich zu hören. Die Erkennung läuft vollständig auf diesem Mac, deine Stimme verlässt das Gerät nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType necesita tu micrófono para oírte. El reconocimiento se ejecuta por completo en este Mac, así que tu voz nunca sale del equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType a besoin de votre microphone pour vous entendre. La reconnaissance s’exécute entièrement sur ce Mac : votre voix ne quitte jamais la machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType があなたの声を聞き取るにはマイクが必要です。認識はすべてこの Mac の中で行われるので、音声がこの Mac から出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType이 말을 들으려면 마이크가 필요합니다. 인식은 전부 이 Mac에서 이루어지므로 음성이 기기 밖으로 나가지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenTalkType 需要麥克風才能聽你說話。辨識全部在這台 Mac 上完成，聲音不會離開電腦。"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonstiges"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他"
          }
        }
      }
    },
    "Overrides the global setting under Text Insertion. A mode meant for a chat window wants to submit every time; a mode for writing documents never should.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt die globale Einstellung unter „Texteinfügung“. Ein Modus fürs Chatfenster will jedes Mal senden, ein Modus zum Schreiben von Dokumenten nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el ajuste global de Inserción de texto. Un modo pensado para una ventana de chat querrá enviar siempre; uno para escribir documentos, nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le réglage global d’Insertion du texte. Un mode destiné à une fenêtre de discussion doit envoyer à chaque fois ; un mode pour rédiger des documents, jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テキスト挿入」の全体設定を上書きします。チャットウインドウ向けのモードは毎回送信したいはずですし、文書を書くためのモードは送信すべきではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘텍스트 삽입’의 전역 설정을 덮어씁니다. 채팅 창용 모드는 매번 전송하는 편이 좋고, 문서를 쓰는 모드는 전송하지 않는 편이 좋습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

            "state": "translated",
            "value": "Ein OpenAI-kompatibler Server auf diesem Mac (Ollama, LM Studio). Transkripte verlassen den Rechner nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

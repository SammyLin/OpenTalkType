    "%@ returned no text. Try a different model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen Text zurückgegeben. Probier ein anderes Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha devuelto texto. Prueba con otro modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a renvoyé aucun texte. Essayez un autre modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からテキストが返りませんでした。別のモデルを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 텍스트가 오지 않았습니다. 다른 모델을 사용해 보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回傳文字，請換個模型再試。"
          }
        }
      }
    },

    "Give an instruction about the selected text and replace it with the result.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Anweisung zum ausgewählten Text und ersetz ihn durch das Ergebnis."
          }
        },

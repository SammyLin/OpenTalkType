    "claude returned no text. Make sure you are signed in by running claude in Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "claude hat keinen Text zurückgegeben. Prüf mit claude im Terminal, ob du angemeldet bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "claude no ha devuelto texto. Comprueba que has iniciado sesión ejecutando claude en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude n’a renvoyé aucun texte. Vérifiez que vous êtes connecté en lançant claude dans le Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude からテキストが返りませんでした。ターミナルで claude を実行して、サインインしているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude가 텍스트를 반환하지 않았습니다. 터미널에서 claude를 실행해 로그인되어 있는지 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "claude 沒有回傳文字，請確認已登入（終端機執行 claude 檢查）。"
          }
        }
      }
    },

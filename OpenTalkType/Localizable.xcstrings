          }
        }
      }
    },
    "Cleanup got no response for 90 seconds and was stopped. The raw transcript is still on the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung hat 90 Sekunden lang nicht geantwortet und wurde gestoppt. Das Rohtranskript liegt weiterhin in der Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza no ha respondido en 90 segundos y se ha detenido. La transcripción original sigue en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage n’a pas répondu pendant 90 secondes et a été interrompu. La transcription brute reste dans le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理が 90 秒間応答しなかったため中止しました。文字起こしの原文はクリップボードに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 작업이 90초 동안 응답하지 않아 중단했습니다. 원본 텍스트는 클립보드에 남아 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理超過 90 秒沒有回應，已中止。原始逐字稿保留在剪貼簿。"
          }
        }
      }
    },

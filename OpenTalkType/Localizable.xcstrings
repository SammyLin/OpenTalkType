    "Abandons the current dictation session: nothing is transcribed, nothing is pasted, nothing is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht das laufende Diktat ab: nichts wird transkribiert, eingefügt oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta el dictado en curso: no se transcribe, no se pega y no se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonne la dictée en cours : rien n’est transcrit, collé ni conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のディクテーションを破棄します。文字起こしも貼り付けも記録も行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 받아쓰기를 취소합니다. 텍스트 변환도, 붙여넣기도, 기록도 하지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄目前這段語音輸入：不轉錄、不貼上、不留紀錄。"
          }
        }
      }
    },
